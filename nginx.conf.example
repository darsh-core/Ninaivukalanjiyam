# Nginx configuration for NinaivuKalanjiyam on AWS EC2 / Lightsail
# Place at: /etc/nginx/sites-available/ninaivukalanjiyam
# Link to:  /etc/nginx/sites-enabled/ninaivukalanjiyam

server {
    listen 80;
    server_name your-domain.com www.your-domain.com; # Or your EC2 Public IP

    # Allow up to 50MB for audio uploads and portrait photos
    client_max_body_size 50M;

    # Gzip Compression for fast loading
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # 1. Frontend React SPA static build
    root /var/www/ninaivukalanjiyam/frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 2. Proxy API requests to Node.js backend
    location /api/ {
        proxy_pass http://127.0.0.1:5002/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
    }
}

# Production Environment Variables for AWS / EC2
PORT=5002
NODE_ENV=production

# PostgreSQL Database (AWS RDS PostgreSQL or Local PostgreSQL on EC2)
# Example AWS RDS URL:
# DATABASE_URL=postgresql://postgres:YourSecurePassword@your-rds-instance.xxxxxx.us-east-1.rds.amazonaws.com:5432/NinaivuKalanjiyam
# Example Local EC2 Postgres:
# DATABASE_URL=postgresql://postgres:YourSecurePassword@localhost:5432/NinaivuKalanjiyam
DATABASE_URL=postgresql://postgres:YourSecurePassword@localhost:5432/NinaivuKalanjiyam

# Set to true if using AWS RDS with SSL enforcement (false for local EC2 PostgreSQL)
DB_SSL=false

# Free Google Gemini API Key (Obtain free at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_free_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional: Groq API Key for Whisper-large-v3 Speech-to-Text (Free tier at: https://console.groq.com/keys)
GROQ_API_KEY=

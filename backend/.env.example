# =======================================================
# NinaivuKalanjiyam Backend Environment Configuration
# =======================================================

# Server Configuration
PORT=5002
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:production_strong_password@localhost:5432/NinaivuKalanjiyam

# Free Google Gemini API Key (Obtain permanently free at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_free_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional: Groq API Key for Whisper-large-v3 Speech-to-Text (Free tier at: https://console.groq.com/keys)
GROQ_API_KEY=
